---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { LANGUAGES, TRANSLATIONS } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title = 'Remove Audio from Video Online Free — Private Video Muter',
  description = 'Remove audio from video online free with zero uploads. Mute MP4, MOV, or WebM videos without watermark directly in your browser—100% private.',
  canonicalPath = Astro.url.pathname,
  ogImage = '/og-image.png',
  ogImageAlt = 'RemoveAudio — Remove Audio from Video Online Free with 100% Privacy and Zero Uploads',
} = Astro.props;

const siteOrigin = 'https://removeaudio.github.io';
const canonicalUrl = new URL(canonicalPath, `${siteOrigin}/`).toString();
const ogImageUrl = new URL(ogImage, `${siteOrigin}/`).toString();
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
const defaultDict = TRANSLATIONS.en;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph Metadata -->
    <meta property="og:site_name" content="RemoveAudio" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Google Tag Manager & Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-5QFTT59Q"></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-F4FP3WDQ25"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-F4FP3WDQ25');
    </script>

    <!-- PWA & Icons -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#F2BED1" id="meta-theme-color" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="RemoveAudio" />

    <!-- Cross-Origin Isolation + Unified Offline PWA Service Worker -->
    <script is:inline src="/coi-serviceworker.js"></script>

    <!-- Zero-flash Theme & Language Bootstrap -->
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('removeaudio-theme');
          if (savedTheme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            const meta = document.getElementById('meta-theme-color');
            if (meta) meta.setAttribute('content', '#191316');
          }
          const savedLang = localStorage.getItem('removeaudio-lang');
          if (savedLang && /^(en|es|pt|de|fr|ja|zh|ru)$/.test(savedLang)) {
            document.documentElement.lang = savedLang;
          }
        } catch {
          // Ignore storage access restrictions
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-inner" aria-label="Primary Navigation">
        <!-- Brand Logo SVG + Name -->
        <a
          href="/"
          class="nav-brand"
          aria-label="RemoveAudio — Home"
          data-i18n-aria="nav.home"
        >
          <svg
            class="nav-brand-logo"
            width="34"
            height="34"
            viewBox="0 0 64 64"
            fill="none"
            aria-hidden="true"
          >
            <rect width="64" height="64" rx="16" fill="#9E476A" />
            <rect
              x="2"
              y="2"
              width="60"
              height="60"
              rx="14"
              stroke="#F2BED1"
              stroke-opacity="0.35"
              stroke-width="2"
            />
            <path
              d="M15 26.5C15 25.1193 16.1193 24 17.5 24H23.6L32.85 16.55C34.16 15.49 36 16.43 36 18.12V45.88C36 47.57 34.16 48.51 32.85 47.45L23.6 40H17.5C16.1193 40 15 38.8807 15 37.5V26.5Z"
              fill="#FFFFFF"
            />
            <path
              d="M43 26L53 38M53 26L43 38"
              stroke="#FDCEDF"
              stroke-width="4.5"
              stroke-linecap="round"
            />
          </svg>
          <span class="nav-brand-text">RemoveAudio</span>
        </a>

        <!-- Ultra-Minimal Right Controls: Language, Theme, Support Dev, GitHub, Menu Toggle -->
        <div class="nav-actions">
          <!-- 1. Language Selector Dropdown (8 Languages) -->
          <div class="nav-popover-wrap">
            <button
              type="button"
              id="lang-trigger"
              class="nav-btn nav-btn-has-label"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="lang-menu"
              aria-label={defaultDict['nav.language']}
              data-i18n-aria="nav.language"
              data-i18n-title="nav.language"
              title={defaultDict['nav.language']}
            >
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              <span class="nav-btn-label" id="lang-current-code">EN</span>
            </button>

            <div id="lang-menu" class="nav-popover lang-menu" role="menu" data-open="false">
              {LANGUAGES.map((lang) => (
                <button
                  type="button"
                  class="lang-option"
                  role="menuitemradio"
                  aria-checked={lang.code === 'en' ? 'true' : 'false'}
                  data-lang-choice={lang.code}
                >
                  <span>{lang.name}</span>
                  <span class="lang-option-code">{lang.shortName}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- 2. Light/Dark Theme Toggle -->
          <button
            type="button"
            id="theme-toggle"
            class="nav-btn"
            aria-label={defaultDict['nav.toggleTheme']}
            data-i18n-aria="nav.toggleTheme"
            data-i18n-title="nav.toggleTheme"
            title={defaultDict['nav.toggleTheme']}
          >
            <svg class="icon-moon" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="icon-sun" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
          </button>

          <!-- 3. Support the Developer CTA -->
          <a
            href="https://kisharadilshan.gumroad.com/coffee"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-btn nav-btn-has-label nav-btn-support"
            aria-label={defaultDict['nav.support']}
            data-i18n-aria="nav.support"
            data-i18n-title="nav.support"
            title={defaultDict['nav.support']}
          >
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
              <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
              <line x1="6" x2="6" y1="2" y2="4" />
              <line x1="10" x2="10" y1="2" y2="4" />
              <line x1="14" x2="14" y1="2" y2="4" />
            </svg>
            <span class="nav-btn-label" data-i18n="nav.support">
              {defaultDict['nav.support']}
            </span>
          </a>

          <!-- 4. GitHub Repository Link: Clean Icon-Only Button -->
          <a
            href="https://github.com/removeaudio/removeaudio.github.io"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-btn"
            aria-label="View Source on GitHub"
            title="View Source on GitHub"
          >
            <svg width="21" height="21" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
              />
            </svg>
          </a>

          <!-- 5. Clean Menu Toggle Icon (Houses Page Links + Add to Home Screen) -->
          <div class="nav-popover-wrap">
            <button
              type="button"
              id="nav-menu-trigger"
              class="nav-btn nav-btn-menu"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="nav-menu-popover"
              aria-label="Open navigation menu"
              title="Menu"
            >
              <svg class="icon-menu-open" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="4" x2="20" y1="7" y2="7" />
                <line x1="4" x2="20" y1="12" y2="12" />
                <line x1="4" x2="20" y1="17" y2="17" />
              </svg>
              <svg class="icon-menu-close" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6 6 18M6 6l12 12" />
              </svg>
            </button>

            <div id="nav-menu-popover" class="nav-popover nav-drawer" role="menu" data-open="false">
              <a
                href="/"
                role="menuitem"
                class="drawer-item"
                aria-current={isActive('/') ? 'page' : undefined}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                  <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
                <span data-i18n="nav.home">{defaultDict['nav.home']}</span>
              </a>

              <a
                href="/how-to-use/"
                role="menuitem"
                class="drawer-item"
                aria-current={isActive('/how-to-use/') ? 'page' : undefined}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                  <line x1="12" x2="12.01" y1="17" y2="17" />
                </svg>
                <span data-i18n="nav.howToUse">{defaultDict['nav.howToUse']}</span>
              </a>

              <a
                href="/privacy/"
                role="menuitem"
                class="drawer-item"
                aria-current={isActive('/privacy/') ? 'page' : undefined}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
                <span data-i18n="nav.privacy">{defaultDict['nav.privacy']}</span>
              </a>

              <a
                href="/hire-me/"
                role="menuitem"
                class="drawer-item"
                aria-current={isActive('/hire-me/') ? 'page' : undefined}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="7" width="20" height="14" rx="2.5" />
                  <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2" />
                  <path d="M2 12h20" />
                </svg>
                <span data-i18n="nav.hireMe">{defaultDict['nav.hireMe']}</span>
                <span class="drawer-live-dot" aria-hidden="true"></span>
              </a>

              <div class="drawer-divider" role="separator"></div>

              <button
                type="button"
                id="pwa-install-btn"
                role="menuitem"
                class="drawer-item drawer-item-pwa"
                aria-label={defaultDict['nav.installPwa']}
                data-i18n-aria="nav.installPwa"
                data-offline-ready="false"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3v12" />
                  <path d="m7 10 5 5 5-5" />
                  <path d="M5 20h14" />
                </svg>
                <span id="pwa-install-label" data-i18n="nav.installPwa">
                  {defaultDict['nav.installPwa']}
                </span>
                <span class="drawer-offline-dot" aria-hidden="true"></span>
              </button>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <Footer />

    <!-- Minimal PWA Offline Install Helper Modal (for iOS / browsers without native prompt) -->
    <div
      id="pwa-modal-backdrop"
      class="pwa-modal-backdrop"
      role="dialog"
      aria-modal="true"
      aria-labelledby="pwa-modal-title"
      data-open="false"
      hidden
    >
      <div class="pwa-modal">
        <div class="pwa-modal-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3v12" />
            <path d="m7 10 5 5 5-5" />
            <path d="M5 20h14" />
          </svg>
        </div>
        <h2 id="pwa-modal-title" data-i18n="pwa.modalTitle">
          {defaultDict['pwa.modalTitle']}
        </h2>
        <p id="pwa-modal-hint" data-i18n="pwa.browserHint">
          {defaultDict['pwa.browserHint']}
        </p>
        <div class="pwa-cache-status" id="pwa-cache-status">
          <span id="pwa-cache-status-text" data-i18n="pwa.cachingEngine">
            {defaultDict['pwa.cachingEngine']}
          </span>
        </div>
        <div>
          <button
            type="button"
            id="pwa-modal-close"
            class="btn-primary"
            style="width: 100%;"
            data-i18n="pwa.close"
          >
            {defaultDict['pwa.close']}
          </button>
        </div>
      </div>
    </div>

    <!-- Lightweight Status Toast -->
    <div
      id="pwa-toast"
      class="pwa-toast"
      role="status"
      aria-live="polite"
      data-visible="false"
    ></div>

    <script>
      import {
        LANGUAGES,
        TRANSLATIONS,
        detectInitialLang,
        isValidLang,
        type LangCode,
        type TranslationDict,
      } from '../i18n/translations';

      interface BeforeInstallPromptEvent extends Event {
        prompt: () => Promise<void>;
        userChoice: Promise<{ outcome: 'accepted' | 'dismissed'; platform: string }>;
      }

      declare global {
        interface Window {
          __removeAudioI18n?: {
            getLang: () => LangCode;
            getDict: () => TranslationDict;
            setLang: (lang: LangCode) => void;
          };
        }
      }

      // -----------------------------------------------------------------------
      // 1. Reactive 8-Language i18n Engine
      // -----------------------------------------------------------------------
      let currentLang: LangCode = detectInitialLang();

      const langTrigger = document.getElementById('lang-trigger');
      const langMenu = document.getElementById('lang-menu');
      const langCurrentCode = document.getElementById('lang-current-code');
      const langOptions = document.querySelectorAll<HTMLButtonElement>('[data-lang-choice]');

      function applyTranslations(lang: LangCode) {
        currentLang = lang;
        const dict = TRANSLATIONS[lang];
        document.documentElement.lang = lang;

        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.dataset.i18n as keyof TranslationDict;
          if (key && key in dict) {
            el.textContent = dict[key];
          }
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach((el) => {
          const key = el.dataset.i18nAria as keyof TranslationDict;
          if (key && key in dict) {
            el.setAttribute('aria-label', dict[key]);
          }
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-title]').forEach((el) => {
          const key = el.dataset.i18nTitle as keyof TranslationDict;
          if (key && key in dict) {
            el.setAttribute('title', dict[key]);
          }
        });

        const meta = LANGUAGES.find((l) => l.code === lang);
        if (langCurrentCode && meta) {
          langCurrentCode.textContent = meta.shortName;
        }

        langOptions.forEach((btn) => {
          btn.setAttribute('aria-checked', btn.dataset.langChoice === lang ? 'true' : 'false');
        });

        try {
          localStorage.setItem('removeaudio-lang', lang);
        } catch {
          // Ignore storage error
        }

        window.dispatchEvent(
          new CustomEvent('removeaudio:langchange', {
            detail: { lang, dict },
          })
        );
      }

      window.__removeAudioI18n = {
        getLang: () => currentLang,
        getDict: () => TRANSLATIONS[currentLang],
        setLang: (lang: LangCode) => {
          if (isValidLang(lang)) applyTranslations(lang);
        },
      };

      applyTranslations(currentLang);

      const navMenuTrigger = document.getElementById('nav-menu-trigger');
      const navMenuPopover = document.getElementById('nav-menu-popover');

      function setNavMenuOpen(open: boolean) {
        if (!navMenuPopover || !navMenuTrigger) return;
        navMenuPopover.dataset.open = open ? 'true' : 'false';
        navMenuTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        navMenuTrigger.setAttribute(
          'aria-label',
          open ? 'Close navigation menu' : 'Open navigation menu'
        );
      }

      function setLangMenuOpen(open: boolean) {
        if (!langMenu || !langTrigger) return;
        langMenu.dataset.open = open ? 'true' : 'false';
        langTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      }

      langTrigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = langMenu?.dataset.open === 'true';
        setNavMenuOpen(false);
        setLangMenuOpen(!isOpen);
      });

      navMenuTrigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = navMenuPopover?.dataset.open === 'true';
        setLangMenuOpen(false);
        setNavMenuOpen(!isOpen);
      });

      langOptions.forEach((btn) => {
        btn.addEventListener('click', () => {
          const choice = btn.dataset.langChoice;
          if (isValidLang(choice)) {
            applyTranslations(choice);
          }
          setLangMenuOpen(false);
        });
      });

      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (
          langMenu?.dataset.open === 'true' &&
          !langMenu.contains(target) &&
          !langTrigger?.contains(target)
        ) {
          setLangMenuOpen(false);
        }
        if (
          navMenuPopover?.dataset.open === 'true' &&
          !navMenuPopover.contains(target) &&
          !navMenuTrigger?.contains(target)
        ) {
          setNavMenuOpen(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          setLangMenuOpen(false);
          setNavMenuOpen(false);
          closePwaModal();
        }
      });

      // -----------------------------------------------------------------------
      // 2. Light / Dark Theme Switcher (Persisted in localStorage)
      // -----------------------------------------------------------------------
      const themeToggle = document.getElementById('theme-toggle');
      const metaThemeColor = document.getElementById('meta-theme-color');

      function applyTheme(theme: 'light' | 'dark') {
        document.documentElement.setAttribute('data-theme', theme);
        if (metaThemeColor) {
          metaThemeColor.setAttribute('content', theme === 'dark' ? '#191316' : '#F2BED1');
        }
        try {
          localStorage.setItem('removeaudio-theme', theme);
        } catch {
          // Ignore storage error
        }
      }

      themeToggle?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        applyTheme(current === 'dark' ? 'light' : 'dark');
      });

      // -----------------------------------------------------------------------
      // 3. PWA "Add to Home Screen" + 100% Offline FFmpeg WASM Pre-Caching
      // -----------------------------------------------------------------------
      let deferredPrompt: BeforeInstallPromptEvent | null = null;
      let offlineFfmpegCached = false;
      let toastTimer: number | null = null;

      const pwaBtn = document.getElementById('pwa-install-btn');
      const pwaInstallLabel = document.getElementById('pwa-install-label');
      const pwaBackdrop = document.getElementById('pwa-modal-backdrop');
      const pwaModalHint = document.getElementById('pwa-modal-hint');
      const pwaCacheText = document.getElementById('pwa-cache-status-text');
      const pwaModalClose = document.getElementById('pwa-modal-close');
      const pwaToast = document.getElementById('pwa-toast');

      function getActiveFfmpegVariant(): 'core-mt' | 'core-st' {
        return typeof SharedArrayBuffer !== 'undefined' && window.crossOriginIsolated
          ? 'core-mt'
          : 'core-st';
      }

      function showToast(message: string) {
        if (!pwaToast) return;
        pwaToast.textContent = message;
        pwaToast.dataset.visible = 'true';
        if (toastTimer) window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          pwaToast.dataset.visible = 'false';
        }, 3800);
      }

      function markOfflineReady() {
        offlineFfmpegCached = true;
        if (pwaBtn) pwaBtn.dataset.offlineReady = 'true';
        if (pwaCacheText) {
          pwaCacheText.dataset.i18n = 'pwa.cachedReady';
          pwaCacheText.textContent = TRANSLATIONS[currentLang]['pwa.cachedReady'];
        }
        window.dispatchEvent(new CustomEvent('removeaudio:offlineready'));
      }

      async function requestOfflineFfmpegCache() {
        if (!('serviceWorker' in navigator)) return;
        try {
          const registration = await navigator.serviceWorker.ready;
          const worker = navigator.serviceWorker.controller || registration.active;
          worker?.postMessage({
            type: 'CACHE_FFMPEG',
            variant: getActiveFfmpegVariant(),
          });
        } catch {
          // Ignore if SW unavailable
        }
      }

      async function checkOfflineFfmpegStatus() {
        if (!('serviceWorker' in navigator)) return;
        try {
          const registration = await navigator.serviceWorker.ready;
          const worker = navigator.serviceWorker.controller || registration.active;
          worker?.postMessage({
            type: 'GET_OFFLINE_STATUS',
            variant: getActiveFfmpegVariant(),
          });
        } catch {
          // Ignore
        }
      }

      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.addEventListener('message', (event) => {
          const data = event.data;
          if (!data || typeof data !== 'object') return;
          if (data.type === 'FFMPEG_CACHED' && data.ready) {
            markOfflineReady();
            showToast(TRANSLATIONS[currentLang]['pwa.cachedReady']);
          } else if (data.type === 'OFFLINE_STATUS' && data.cached) {
            markOfflineReady();
          }
        });
        checkOfflineFfmpegStatus();
      }

      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e as BeforeInstallPromptEvent;
      });

      window.addEventListener('appinstalled', () => {
        deferredPrompt = null;
        if (pwaInstallLabel) {
          pwaInstallLabel.dataset.i18n = 'nav.installedPwa';
          pwaInstallLabel.textContent = TRANSLATIONS[currentLang]['nav.installedPwa'];
        }
        requestOfflineFfmpegCache();
        showToast(TRANSLATIONS[currentLang]['pwa.alreadyInstalled']);
      });

      function openPwaModal() {
        if (!pwaBackdrop) return;
        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
        if (pwaModalHint) {
          const hintKey = isIOS ? 'pwa.iosHint' : 'pwa.browserHint';
          pwaModalHint.dataset.i18n = hintKey;
          pwaModalHint.textContent = TRANSLATIONS[currentLang][hintKey];
        }
        if (pwaCacheText) {
          const statusKey = offlineFfmpegCached ? 'pwa.cachedReady' : 'pwa.cachingEngine';
          pwaCacheText.dataset.i18n = statusKey;
          pwaCacheText.textContent = TRANSLATIONS[currentLang][statusKey];
        }
        pwaBackdrop.hidden = false;
        requestAnimationFrame(() => {
          pwaBackdrop.dataset.open = 'true';
        });
      }

      function closePwaModal() {
        if (!pwaBackdrop || pwaBackdrop.hidden) return;
        pwaBackdrop.dataset.open = 'false';
        window.setTimeout(() => {
          pwaBackdrop.hidden = true;
        }, 200);
      }

      pwaModalClose?.addEventListener('click', closePwaModal);
      pwaBackdrop?.addEventListener('click', (e) => {
        if (e.target === pwaBackdrop) closePwaModal();
      });

      pwaBtn?.addEventListener('click', async () => {
        setNavMenuOpen(false);
        const isStandalone =
          window.matchMedia('(display-mode: standalone)').matches ||
          (navigator as Navigator & { standalone?: boolean }).standalone === true;

        // Always warm the offline FFmpeg WASM cache when user taps Add to Home Screen
        if (!offlineFfmpegCached) {
          requestOfflineFfmpegCache();
        }

        if (isStandalone) {
          showToast(TRANSLATIONS[currentLang]['pwa.alreadyInstalled']);
          return;
        }

        if (deferredPrompt) {
          await deferredPrompt.prompt();
          const { outcome } = await deferredPrompt.userChoice;
          if (outcome === 'accepted') {
            deferredPrompt = null;
            showToast(TRANSLATIONS[currentLang]['pwa.cachingEngine']);
          }
          return;
        }

        openPwaModal();
      });
    </script>
  </body>
</html>
