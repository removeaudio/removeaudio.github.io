---
import JsonLd from './JsonLd.astro';

export interface BreadcrumbItem {
  label: string;
  href: string;
  i18nKey?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const baseUrl = 'https://removeaudio.github.io';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: item.label,
    item: new URL(item.href, baseUrl).toString(),
  })),
};
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs-list">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="breadcrumbs-item">
          {isLast ? (
            <span
              class="breadcrumbs-current"
              aria-current="page"
              data-i18n={item.i18nKey}
            >
              {item.label}
            </span>
          ) : (
            <>
              <a
                href={item.href}
                class="breadcrumbs-link"
                data-i18n={item.i18nKey}
              >
                {item.label}
              </a>
              <span class="breadcrumbs-sep" aria-hidden="true">/</span>
            </>
          )}
        </li>
      );
    })}
  </ol>
</nav>

<JsonLd schema={breadcrumbSchema} />

<style>
  .breadcrumbs {
    margin-bottom: 18px;
  }

  .breadcrumbs-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .breadcrumbs-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumbs-link {
    color: var(--text-muted);
    transition: color 0.18s ease;
  }

  .breadcrumbs-link:hover {
    color: var(--cta-bg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(:root[data-theme='dark']) .breadcrumbs-link:hover {
    color: var(--accent-border);
  }

  .breadcrumbs-sep {
    color: var(--accent-border-strong);
    user-select: none;
  }

  .breadcrumbs-current {
    color: var(--text-heading);
    font-weight: 700;
  }
</style>
