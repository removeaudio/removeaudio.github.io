{
  "name": "removeaudio",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "100% client-side, privacy-first tool to remove audio from videos instantaneously in the browser using WebAssembly FFmpeg.",
  "homepage": "https://removeaudio.github.io/",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "sync:ffmpeg": "node scripts/sync-ffmpeg.mjs",
    "postinstall": "node scripts/sync-ffmpeg.mjs",
    "dev": "node scripts/sync-ffmpeg.mjs && astro dev",
    "build": "node scripts/sync-ffmpeg.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
